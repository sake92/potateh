amends "https://sake92.github.io/deder/config/v0.22.2/DederProject.pkl"

repositories {
  new MavenRepository { url = "https://central.sonatype.com/repository/maven-snapshots/" }
}

local const publishRepo = if (read?("env:DEDER_PUBLISH_SNAPSHOT") == "true")
  new SonatypeSnapshotRepo { id = "sonatype" }
else
  new SonatypeCentralRepo { id = "sonatype" }

local const nativeVersion = read?("env:POTATEH_SCALA_NATIVE_VERSION") ?? "0.5.12"

local const core = new CreateCrossModules {
  root = "potateh"
  template = new {
    scalaVersion = "3.9.0"
    javaVersion = "21"
    javaHome = read("env:JAVA_HOME")
    scalacOptions { "-release:21"; "-deprecation"; "-feature" }
    publish = true
    publishTo = publishRepo
    pomSettings = new {
      groupId = "ba.sake"
      artifactId = "potateh"
      name = "potateh"
      description = "Blocking HTTP/1 server for Scala"
      url = "https://github.com/sake92/potateh"
      licenses { new PomLicense { name = "Apache-2.0"; url = "https://www.apache.org/licenses/LICENSE-2.0" } }
      developers {
        new PomDeveloper {
          id = "sake92"
          name = "Sakib Hadžiavdić"
          email = "sake92@sake.ba"
        }
      }
      scm {
        url = "https://github.com/sake92/potateh"
        connection = "scm:git:git@github.com:sake92/potateh.git"
      }
    }
  }
  testTemplate = (template.asTest()) {
    sources { "src-jvm" }
    deps { "org.scalameta::munit::1.3.6" }
    testParallelism = 1
  }
  nativeTemplate = (template.asNative()) {
    scalaNativeVersion = nativeVersion
    multithreading = true
  }
  nativeTestTemplate = (nativeTemplate.asTest()) {
    deps { "org.scalameta::munit::1.3.6" }
  }
}.get

local const fixture: ScalaModule = new {
  id = "fixture-jvm"
  root = "conformance"
  sources = new Listing { "shared" }
  scalaVersion = "3.9.0"
  javaVersion = "21"
  javaHome = read("env:JAVA_HOME")
  scalacOptions { "-release:21" }
  moduleDeps { core.jvm }
  mainClass = "conformance.ConformanceServer"
}
local const nativeFixture = (fixture.asNative()) {
  id = "fixture-native"
  scalaNativeVersion = nativeVersion
  multithreading = true
  mode = "release-fast"
  moduleDeps = new Listing { core.native }
}

local const microBenchmarks = (fixture.asNative()) {
  id = "micro-benchmarks"
  root = "microbenchmarks"
  sources = new Listing { "src" }
  scalaNativeVersion = nativeVersion
  multithreading = true
  mode = "release-fast"
  moduleDeps = new Listing { core.native }
  mainClass = "ba.sake.potateh.RequestHeadBenchmark"
}

modules {
  core.jvm
  core.jvm_test
  core.native
  core.native_test
  fixture
  nativeFixture
  microBenchmarks
}
